  "description": "An ephemeral Commander deck removal checklist for Moxfield decks.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucasc017/card-deck-swapper.git"
  },
  "homepage": "https://lucasc017.github.io/card-deck-swapper/",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
